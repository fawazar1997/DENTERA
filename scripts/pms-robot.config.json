{
  "$comment": "How the robot reaches each PMS report. No secrets here (the username and password are GitHub secrets). 'menu' is the path clicked in the PMS menu, 'steps' fill the report's filters ({from} and {to} become dates in 'dateFormat'), 'export' is the button whose click downloads the file.",
  "baseUrl": "https://dentera.microchips-cloud.com/pms/",
  "dateFormat": "dd/MM/yyyy",
  "login": {
    "url": "https://dentera.microchips-cloud.com/pms/",
    "user": "#username-txt",
    "password": "#password-txt",
    "submit": "#login-btn",
    "after": ""
  },
  "dismiss": [
    "OK, continue"
  ],
  "reports": [
    {
      "name": "sales",
      "menu": [
        "Reports",
        "Financial Reports",
        "Sales Report"
      ],
      "steps": [
        {
          "clickText": "Filters"
        },
        {
          "wait": 1000
        },
        {
          "fill": "#fromDate-txt",
          "value": "{from}"
        },
        {
          "fill": "#toDate-txt",
          "value": "{to}"
        },
        {
          "select": "#branch-select",
          "value": "{branch}"
        },
        {
          "wait": 500
        }
      ],
      "export": "Apply Filters (Excel)",
      "branches": [
        "Abha",
        "Khamis"
      ],
      "alternatives": [
        {
          "steps": [
            {
              "clickText": "Filters"
            },
            {
              "wait": 1000
            },
            {
              "fill": "#fromDate-txt",
              "value": "{from}"
            },
            {
              "fill": "#toDate-txt",
              "value": "{to}"
            },
            {
              "select": "#branch-select",
              "value": "{branch}"
            },
            {
              "wait": 500
            },
            {
              "clickText": "Apply Filters (SP)"
            },
            {
              "wait": 20000
            }
          ],
          "export": "Excel"
        }
      ],
      "keep": [
        "invdate",
        "patientfileno",
        "patientidnumber",
        "invoiceno",
        "price",
        "totaldiscount",
        "totalpriceafterdiscount",
        "totalrowpaid",
        "remaining",
        "doctor",
        "clinc",
        "branchname",
        "revenuetypedesc",
        "invtype",
        "originalinvseqno"
      ],
      "keepPattern": "^(cash|mada|master|visa|stc ?pay|bank|tabby|tamara|emkan|moyasar)",
      "totalColumn": "totalpriceafterdiscount"
    },
    {
      "name": "detailed-sales",
      "menu": [
        "Reports",
        "Financial Reports",
        "Detailed Sales Report"
      ],
      "steps": [
        {
          "clickText": "Filters"
        },
        {
          "wait": 1000
        },
        {
          "fill": "#fromDate-txt",
          "value": "{from}"
        },
        {
          "fill": "#toDate-txt",
          "value": "{to}"
        }
      ],
      "export": "Excel (SP)"
    },
    {
      "name": "new-old-patients",
      "strict": true,
      "$comment": "Being set up: discover only (enabled false, so scheduled runs skip it). Logs column titles and counts, never patient data.",
      "menu": [
        "Reports",
        "Appointments Reports",
        "New-Old Patients"
      ],
      "enabled": false,
      "range": "month",
      "steps": [
        {
          "clickText": "Filters"
        },
        {
          "wait": 1500
        },
        {
          "fill": "#date-txt",
          "value": "{from} - {to}"
        },
        {
          "clickText": "Apply Filters"
        },
        {
          "wait": 15000
        }
      ],
      "export": "Excel",
      "alternatives": [],
      "timeout": 60000
    },
