    {
      "name": "appointments",
      "strict": true,
      "$comment": "Being set up: discover only (enabled false, so scheduled runs skip it). Logs column titles and counts, never patient data.",
      "menu": [
        "Reports",
        "Appointments Reports",
        "Appointments Report"
      ],
      "enabled": false,
      "steps": [
        {
          "clickText": "Filters"
        },
        {
          "wait": 1500
        },
        {
          "fill": "#fromDate-txt",
          "value": "{from}"
        },
        {
          "fill": "#toDate-txt",
          "value": "{to}"
        },
        {
          "select": "#branch-select",
          "value": "{branch}"
        },
        {
          "select": "#doctorsL-select",
          "value": "All"
        },
        {
          "wait": 1000
        },
        {
          "net": "start"
        },
        {
          "clickText": "Apply Filters"
        },
        {
          "wait": 12000
        },
        {
          "say": "after apply"
        },
        {
          "net": "print"
        },
        {
          "clickText": "Filters"
        },
        {
          "wait": 1500
        }
      ],
      "export": "Excel",
      "alternatives": [],
      "timeout": 60000,
      "branches": [
        "Abha"
      ],
      "valuesOf": [
        "Appointment Status",
        "New / Old",
        "Is Confirmed",
        "Appointment Source",
        "Appointment Type"
      ],
      "kind": "appointments",
      "dateKey": "date",
      "hash": [
        "fileno"
      ],
      "keep": [
        "date",
        "time",
        "fileno",
        "appointmenttype",
        "appointmentsource",
        "addedon",
        "doctor",
        "appointmentstatus",
        "noshowcount",
        "invoiceno",
        "newold",
        "isconfirmed",
        "appointmentservice"
      ],
      "range": "month"
    },
