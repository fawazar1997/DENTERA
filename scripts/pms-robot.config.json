          },
          {
            "clickText": "Run Report"
          },
          {
            "wait": 10000
          }
        ],
        "export": "Excel",
        "kind": "statement",
        "accounts": "^(1101|1102|1105|2101|2102|2103|2201|2202|4103|4106|4109)|doctor comm|technicians comm",
        "listFrom": [
