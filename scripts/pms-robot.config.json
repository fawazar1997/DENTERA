{
  "$comment": "How the robot reaches each PMS report. No secrets here (the username and password are GitHub secrets). 'menu' is the path clicked in the PMS menu, 'steps' fill the report's filters ({from} and {to} become dates in 'dateFormat'), 'export' is the button whose click downloads the file.",
  "baseUrl": "https://dentera.microchips-cloud.com/pms/",
  "dateFormat": "dd/MM/yyyy",
  "login": {
    "url": "https://dentera.microchips-cloud.com/pms/",
    "user": "#username-txt",
    "password": "#password-txt",
    "submit": "#login-btn",
    "after": ""
  },
  "dismiss": [
    "OK, continue"
  ],
  "reports": [
    {
      "name": "sales",
      "menu": [
        "Reports",
        "Financial Reports",
        "Sales Report"
      ],
      "steps": [
        {
          "clickText": "Filters"
        },
        {
          "wait": 1000
        },
        {
          "fill": "#fromDate-txt",
          "value": "{from}"
        },
        {
          "fill": "#toDate-txt",
          "value": "{to}"
        },
        {
          "select": "#branch-select",
          "value": "{branch}"
        },
        {
          "wait": 500
        }
      ],
      "export": "Apply Filters (Excel)",
      "branches": [
        "Abha",
        "Khamis"
      ],
      "alternatives": [
        {
          "steps": [
            {
              "clickText": "Filters"
            },
            {
              "wait": 1000
            },
            {
              "fill": "#fromDate-txt",
              "value": "{from}"
            },
            {
              "fill": "#toDate-txt",
              "value": "{to}"
            },
            {
              "select": "#branch-select",
              "value": "{branch}"
            },
            {
              "wait": 500
            },
            {
              "clickText": "Apply Filters (SP)"
            },
            {
              "wait": 20000
            }
          ],
          "export": "Excel"
        }
      ],
      "keep": [
        "invdate",
        "patientfileno",
        "patientidnumber",
        "invoiceno",
        "price",
        "totaldiscount",
        "totalpriceafterdiscount",
        "totalrowpaid",
        "remaining",
        "doctor",
        "clinc",
        "branchname",
        "revenuetypedesc",
        "invtype",
        "originalinvseqno"
      ],
      "keepPattern": "^(cash|mada|master|visa|stc ?pay|bank|tabby|tamara|emkan|moyasar)",
      "totalColumn": "totalpriceafterdiscount"
    },
    {
      "name": "detailed-sales",
      "menu": [
        "Reports",
        "Financial Reports",
        "Detailed Sales Report"
      ],
      "steps": [
        {
          "clickText": "Filters"
        },
        {
          "wait": 1000
        },
        {
          "fill": "#fromDate-txt",
          "value": "{from}"
        },
        {
          "fill": "#toDate-txt",
          "value": "{to}"
        }
      ],
      "export": "Excel (SP)"
    }
  ],
  "accounting": {
    "$comment": "Microchips Accounting: its own address and account (GitHub secrets ACCT_USER, ACCT_PASSWORD). Read-only: the robot never presses post, unpost, approve, save, delete or edit (scripts/robot-safety.mjs). 'explore' lists the links under those top menu items (discover only).",
    "login": {
      "url": "https://dentera.microchips-cloud.com/accounting/Home/Login",
      "user": "input[type=text]:visible, input[type=email]:visible, input[name*=user i], input[id*=user i]",
      "password": "input[type=password]",
      "submit": "button[type=submit], input[type=submit], button:has-text('Login'), button:has-text('Sign in'), button:has-text('دخول'), button:has-text('تسجيل الدخول')",
      "after": ""
    },
    "reports": [],
    "explore": [
      "Reports",
      "Accounting"
    ]
  }
}
