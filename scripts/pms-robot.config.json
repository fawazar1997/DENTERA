{
  "$comment": "How the robot reaches each PMS report. No secrets here (the username and password are GitHub secrets). 'menu' is the path clicked in the PMS menu, 'steps' fill the report's filters ({from} and {to} become dates in 'dateFormat'), 'export' is the button whose click downloads the file.",
  "baseUrl": "https://dentera.microchips-cloud.com/pms/",
  "dateFormat": "dd/MM/yyyy",
  "login": {
    "url": "https://dentera.microchips-cloud.com/pms/",
    "user": "#username-txt",
    "password": "#password-txt",
    "submit": "#login-btn",
    "after": ""
  },
  "dismiss": [
    "OK, continue"
  ],
  "reports": [
    {
      "name": "sales",
      "menu": [
        "Reports",
        "Financial Reports",
        "Sales Report"
      ],
      "steps": [
        {
          "clickText": "Filters"
        },
        {
          "wait": 1000
        },
        {
          "fill": "#fromDate-txt",
          "value": "{from}"
        },
        {
          "fill": "#toDate-txt",
          "value": "{to}"
        },
        {
          "select": "#branch-select",
          "value": "{branch}"
        },
        {
          "wait": 500
        }
      ],
      "export": "Apply Filters (Excel)",
      "branches": [
        "Abha",
        "Khamis"
      ],
      "alternatives": [
        {
          "steps": [
            {
              "clickText": "Filters"
            },
            {
              "wait": 1000
            },
            {
              "fill": "#fromDate-txt",
              "value": "{from}"
            },
            {
              "fill": "#toDate-txt",
              "value": "{to}"
            },
            {
              "select": "#branch-select",
              "value": "{branch}"
            },
            {
              "wait": 500
            },
            {
              "clickText": "Apply Filters (SP)"
            },
            {
              "wait": 20000
            }
          ],
          "export": "Excel"
        }
      ],
      "keep": [
        "invdate",
        "patientfileno",
        "patientidnumber",
        "invoiceno",
        "price",
        "totaldiscount",
        "totalpriceafterdiscount",
        "totalrowpaid",
        "remaining",
        "doctor",
        "clinc",
        "branchname",
        "revenuetypedesc",
        "invtype",
        "originalinvseqno"
      ],
      "keepPattern": "^(cash|mada|master|visa|stc ?pay|bank|tabby|tamara|emkan|moyasar)",
      "totalColumn": "totalpriceafterdiscount"
    },
    {
      "name": "detailed-sales",
      "menu": [
        "Reports",
        "Financial Reports",
        "Detailed Sales Report"
      ],
      "steps": [
        {
          "clickText": "Filters"
        },
        {
          "wait": 1000
        },
        {
          "fill": "#fromDate-txt",
          "value": "{from}"
        },
        {
          "fill": "#toDate-txt",
          "value": "{to}"
        }
      ],
      "export": "Excel (SP)"
    }
  ],
  "accounting": {
    "$comment": "Microchips Accounting: its own address and account (GitHub secrets ACCT_USER, ACCT_PASSWORD). Read-only: the robot never presses post, unpost, approve, save, delete, edit or «New Account» (scripts/robot-safety.mjs). 'url' opens a report page directly; 'range' is the period (month or year to date, else the day before); 'steps' fill its Filters window and «Run Report»; 'export' is the download button; 'look' (discover only) shows a page without downloading. 'kind' (tb, chart) sends the export to the site's /api/finance/acct-ingest; 'basis' posted = posted only, all = with not-posted entries.",
    "login": {
      "url": "https://dentera.microchips-cloud.com/accounting/Home/Login",
      "user": "input[type=text]:visible, input[type=email]:visible, input[name*=user i], input[id*=user i]",
      "password": "input[type=password]",
      "submit": "button[type=submit], input[type=submit], button:has-text('Login'), button:has-text('Sign in'), button:has-text('دخول'), button:has-text('تسجيل الدخول')",
      "after": ""
    },
    "reports": [
      {
        "name": "trial-balance",
        "url": "/accounting/TrailBalanceFull/Index",
        "range": "month",
        "steps": [
          {
            "clickText": "Filters"
          },
          {
            "wait": 1500
          },
          {
            "fill": "#fromDate-txt",
            "value": "{from}"
          },
          {
            "fill": "#toDate-txt",
            "value": "{to}"
          },
          {
            "select": "#filterbranches-select",
            "value": "{branch}"
          },
          {
            "check": "#notPosted-checkbox",
            "value": false
          },
          {
            "check": "#showLastAccountsOnly-checkbox",
            "value": true
          },
          {
            "clickText": "Run Report"
          },
          {
            "wait": 8000
          }
        ],
        "export": "Excel",
        "branches": [
          "Abha",
          "Khamis",
          ""
        ],
        "kind": "tb",
        "basis": "posted"
      },
      {
        "name": "trial-balance-with-unposted",
        "url": "/accounting/TrailBalanceFull/Index",
        "range": "month",
        "steps": [
          {
            "clickText": "Filters"
          },
          {
            "wait": 1500
          },
          {
            "fill": "#fromDate-txt",
            "value": "{from}"
          },
          {
            "fill": "#toDate-txt",
            "value": "{to}"
          },
          {
            "select": "#filterbranches-select",
            "value": "{branch}"
          },
          {
            "check": "#notPosted-checkbox",
            "value": true
          },
          {
            "check": "#showLastAccountsOnly-checkbox",
            "value": true
          },
          {
            "clickText": "Run Report"
          },
          {
            "wait": 8000
          }
        ],
        "export": "Excel",
        "branches": [
          "Abha",
          "Khamis",
          ""
        ],
        "kind": "tb",
        "basis": "all"
      },
      {
        "name": "account-statement",
        "url": "/accounting/AccountStatement/Index",
        "range": "year",
        "steps": [
          {
            "clickText": "Filters"
          },
          {
            "wait": 1500
          },
          {
            "fill": "#fromDate-txt",
            "value": "{from}"
          },
          {
            "fill": "#toDate-txt",
            "value": "{to}"
          },
          {
            "check": "#notPosted-checkbox",
            "value": true
          },
          {
            "selectMatch": "#accounts-select",
            "value": "{account}"
          },
          {
            "clickText": "Run Report"
          },
          {
            "wait": 10000
          }
        ],
        "export": "Excel",
        "kind": "statement",
        "accounts": "^(1101|1102|1105|2101|2102|2103|2201|2202)|doctor comm|technicians comm",
        "listFrom": [
          {
            "clickText": "Filters"
          },
          {
            "wait": 1500
          }
        ]
      },
      {
        "name": "journal-entries",
        "url": "/accounting/JournalEntries/Index",
        "look": [
          {
            "wait": 2000
          }
        ]
      },
      {
        "name": "income-statement",
        "url": "/accounting/IncomeStatement/Index",
        "range": "year",
        "steps": [
          {
            "clickText": "Filters"
          },
          {
            "wait": 1500
          },
          {
            "fill": "#fromDate-txt",
            "value": "{from}"
          },
          {
            "fill": "#toDate-txt",
            "value": "{to}"
          },
          {
            "select": "#reportFormat-select",
            "value": "Monthly Detailed"
          },
          {
            "select": "#postStatus-select",
            "value": "Posted only"
          },
          {
            "clickText": "Run Report"
          },
          {
            "wait": 8000
          }
        ],
        "export": "Excel"
      },
      {
        "name": "unposted",
        "url": "/accounting/GeneralReports/UnPostedTransactionsReport",
        "range": "year",
        "look": [
          {
            "fill": "#fromDate-txt",
            "value": "{from}"
          },
          {
            "fill": "#toDate-txt",
            "value": "{to}"
          },
          {
            "clickText": "Load Report"
          },
          {
            "wait": 8000
          }
        ],
        "kind": "unposted"
      },
      {
        "name": "chart-of-accounts",
        "url": "/accounting/ChartOfAccounts/Index",
        "steps": [
          {
            "wait": 1500
          }
        ],
        "export": "Excel",
        "kind": "chart"
      },
      {
        "name": "suppliers-aging",
        "url": "/accounting/SuppliersAgingReport/Index",
        "steps": [
          {
            "clickText": "Filters"
          },
          {
            "wait": 1500
          },
          {
            "fill": "#upToDate-txt",
            "value": "{to}"
          },
          {
            "clickText": "Run Report"
          },
          {
            "wait": 8000
          }
        ],
        "export": "Excel"
      }
    ],
    "explore": [],
    "dateFormat": "dd/MM/yyyy"
  }
}
