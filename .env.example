# Copy this file to .env.local and set your own values before running in production.

# Password required to sign in to the /admin control panel.
ADMIN_PASSWORD=change-me-please

# Random secret used to sign the admin session cookie. Use a long random string.
SESSION_SECRET=change-this-to-a-long-random-string

# Enables doctor photo / banner image uploads via Vercel Blob storage.
# Provided automatically once you enable Vercel Blob for this project
# (Vercel dashboard -> your project -> Storage -> Create Database -> Blob).
# Leave unset locally if you don't need to test uploads — the rest of the
# admin panel works fine without it.
BLOB_READ_WRITE_TOKEN=
